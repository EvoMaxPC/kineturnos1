# Gemini: secret del servidor, nunca del frontend
GEMINI_API_KEY=

# URL pública base de KineTurnos
APP_URL=https://tu-dominio.example

# Twilio WhatsApp (credenciales en el gestor de secretos del hosting)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+549XXXXXXXXXX

# URL HTTPS EXACTA configurada en Twilio: https://tu-dominio.example/webhook/twilio
# Debe coincidir carácter por carácter para validar X-Twilio-Signature.
TWILIO_WEBHOOK_URL=https://tu-dominio.example/webhook/twilio
